                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "OK": {
                        "color": "green",
                        "text": "OK"
                      },
                      "Unreachable / collection failed": {
                        "color": "red",
                        "text": "Unreachable / failed"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Architecture"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "enablePagination": false,
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "last_over_time({job=\"host_maintenance\",host=~\"${maintenance_host:regex}\"} | json | unwrap observed_at_ms | __error__=\"\" [7d]) by (host,os,architecture,runtime,kernel,reboot_required,collection_status,last_successful_update_ms,last_package_upgrade_ms,update_source)",
          "instant": true,
          "legendFormat": "{{host}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Host maintenance · all managed guests",
      "transformations": [
