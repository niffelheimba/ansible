{
  "dashboardUid": "homelab-security",
  "variable": {
    "allValue": ".*",
    "current": {
      "text": "All",
      "value": "$__all"
    },
    "datasource": {
      "type": "loki",
      "uid": "loki"
    },
    "definition": "label_values({job=\"host_maintenance\"},host)",
    "includeAll": true,
    "label": "Managed host",
    "multi": true,
    "name": "maintenance_host",
    "options": [],
    "query": "label_values({job=\"host_maintenance\"},host)",
    "refresh": 2,
    "sort": 1,
    "type": "query"
  },
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Inventory hosts with a stored maintenance observation older than two hours at the selected end time. Unknown/failed readings are marked in the table. No data means no events in the seven-day lookback.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "id": 14,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(max by(host)(last_over_time({job=\"host_maintenance\",host=~\"${maintenance_host:regex}\"} | json | unwrap observed_at_ms | __error__=\"\" [7d])) < bool (${__to} - 7200000))",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Maintenance readings older than 2h",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Latest reading per inventory host in the last 7 days. Independent of the journal Host filter. Update checks are verified per host; last package upgrade comes from completed APT Upgrade transactions. Shared-kernel guests cannot establish hypervisor reboot requirements.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          },
          "mappings": [],
          "noValue": "Unknown"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Host"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 230
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Lynis findings",
                    "url": "/d/lynis-audits/lynis-security-audits?var-host=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last successful update check"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last package upgrade"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last checked"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reboot needed"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 210
              },
              {
